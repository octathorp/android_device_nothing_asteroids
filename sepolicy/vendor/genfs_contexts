# Charger
genfscon sysfs /class/qcom-battery/charge_control_en     u:object_r:vendor_sysfs_usb_supply:s0
genfscon sysfs /class/qcom-battery/wireless_boost_en     u:object_r:vendor_sysfs_wireless:s0
genfscon sysfs /devices/platform/soc/88e0000.qcom,msm-eud/extcon/extcon0/cable.1/name     u:object_r:vendor_sysfs_usb_supply:s0

# Display
genfscon sysfs /devices/platform/soc/soc:qcom,dsi-display-primary     u:object_r:vendor_sysfs_graphics:s0

# Fingerprint
genfscon sysfs /panel_feature/fp_status     u:object_r:vendor_sysfs_fingerprint:s0

# Touchpanel
genfscon proc /touchpanel/fod_mode          u:object_r:vendor_proc_touchpanel:s0
genfscon proc /touchpanel/gesture_mode      u:object_r:vendor_proc_touchpanel:s0

# Wakeup
genfscon sysfs /devices/platform/soc/a600000.ssusb/a600000.dwc3/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc/soc:goodix_fp@0/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/virtual/input/input4/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc/8c0000.qcom,qupv3_1_geni_se/880000.i2c/i2c-7/7-003a/wakeup/wakeup16     u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc/8c0000.qcom,qupv3_1_geni_se/880000.i2c/i2c-7/7-003a/wakeup/wakeup16/event_count    u:object_r:sysfs_wakeup:s0
